{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "web/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/" } },
    { "src": "/review-intel/", "has": [{ "type": "host", "value": "^reviews\\.doubledash\\.me$" }], "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/" } },
    { "src": "/review-intel/setup/", "has": [{ "type": "host", "value": "^reviews\\.doubledash\\.me$" }], "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/setup/" } },
    { "src": "/review-intel/privacy/", "has": [{ "type": "host", "value": "^reviews\\.doubledash\\.me$" }], "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/privacy/" } },
    { "src": "/review-intel/extension/privacy/", "has": [{ "type": "host", "value": "^reviews\\.doubledash\\.me$" }], "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/extension/privacy/" } },
    { "src": "/extension/privacy", "has": [{ "type": "host", "value": "^reviews\\.doubledash\\.me$" }], "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/extension/privacy/" } },
    { "src": "/extension/privacy/", "has": [{ "type": "host", "value": "^reviews\\.doubledash\\.me$" }], "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/extension/privacy/" } },
    { "src": "/review-intel/review-intelligence-method.md", "has": [{ "type": "host", "value": "^reviews\\.doubledash\\.me$" }], "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/review-intelligence-method.md" } },
    { "src": "/review-intelligence-method.md", "has": [{ "type": "host", "value": "^reviews\\.doubledash\\.me$" }], "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/review-intelligence-method.md" } },
    { "src": "/review-intel/app-review-growth-analyzer-skill.zip", "has": [{ "type": "host", "value": "^reviews\\.doubledash\\.me$" }], "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/app-review-growth-analyzer-skill.zip" } },
    { "src": "/app-review-growth-analyzer-skill.zip", "has": [{ "type": "host", "value": "^reviews\\.doubledash\\.me$" }], "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/app-review-growth-analyzer-skill.zip" } },
    { "src": "/review-intel/llms.txt", "has": [{ "type": "host", "value": "^reviews\\.doubledash\\.me$" }], "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/llms.txt" } },
    { "src": "/llms.txt", "has": [{ "type": "host", "value": "^reviews\\.doubledash\\.me$" }], "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/llms.txt" } },
    { "src": "/review-intel/robots.txt", "has": [{ "type": "host", "value": "^reviews\\.doubledash\\.me$" }], "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/robots.txt" } },
    { "src": "/robots.txt", "has": [{ "type": "host", "value": "^reviews\\.doubledash\\.me$" }], "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/robots.txt" } },
    { "src": "/review-intel/sitemap.xml", "has": [{ "type": "host", "value": "^reviews\\.doubledash\\.me$" }], "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/sitemap.xml" } },
    { "src": "/sitemap.xml", "has": [{ "type": "host", "value": "^reviews\\.doubledash\\.me$" }], "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/sitemap.xml" } },
    { "src": "/mcp", "dest": "/api/mcp.js" },
    { "src": "/api/search", "dest": "/api/search.js" },
    { "src": "/api/extract", "dest": "/api/extract.js" },
    { "src": "/review-intel", "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/" } },
    { "src": "/review-intel/", "dest": "/web/index.html" },
    { "src": "/review-intel/mcp", "dest": "/api/mcp.js" },
    { "src": "/review-intel/setup", "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/setup/" } },
    { "src": "/review-intel/setup/", "dest": "/web/setup.html" },
    { "src": "/review-intel/privacy", "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/privacy/" } },
    { "src": "/review-intel/privacy/", "dest": "/web/privacy.html" },
    { "src": "/review-intel/api/search", "dest": "/api/search.js" },
    { "src": "/review-intel/api/extract", "dest": "/api/extract.js" },
    { "src": "/review-intel/styles.css", "dest": "/web/styles.css" },
    { "src": "/review-intel/tokens.css", "dest": "/web/tokens.css" },
    { "src": "/review-intel/app.js", "dest": "/web/app.js" },
    { "src": "/review-intel/analytics.js", "dest": "/web/analytics.js" },
    { "src": "/review-intel/analysis-prompt.js", "dest": "/web/analysis-prompt.js" },
    { "src": "/review-intel/markets.js", "dest": "/web/markets.js" },
    { "src": "/review-intel/storefronts.js", "dest": "/web/storefronts.js" },
    { "src": "/review-intel/review-intelligence-method.js", "dest": "/web/review-intelligence-method.js" },
    { "src": "/review-intel/review-intelligence-method.md", "dest": "/web/review-intelligence-method.md" },
    { "src": "/review-intel/app-review-growth-analyzer-skill.zip", "dest": "/web/app-review-growth-analyzer-skill.zip" },
    { "src": "/review-intel/review-retriever-og.png", "dest": "/web/review-retriever-og.png" },
    { "src": "/review-intel/review-intel-og-20260926.png", "dest": "/web/review-intel-og-20260926.png" },
    { "src": "/review-intel/review-retriever-og.svg", "dest": "/web/review-retriever-og.svg" },
    { "src": "/review-intel/favicon.svg", "dest": "/web/favicon.svg" },
    { "src": "/review-intel/extension/privacy", "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/extension/privacy/" } },
    { "src": "/review-intel/extension/privacy/", "dest": "/web/extension-privacy.html" },
    { "src": "/review-intel/robots.txt", "dest": "/web/robots.txt" },
    { "src": "/review-intel/sitemap.xml", "dest": "/web/sitemap.xml" },
    { "src": "/review-intel/llms.txt", "dest": "/web/llms.txt" },
    { "src": "/setup/?", "status": 308, "headers": { "Location": "https://www.willthiseverwork.com/review-intel/setup/" } },
    { "src": "/extension/privacy/?", "dest": "/web/extension-privacy.html" },
    { "src": "/styles.css", "dest": "/web/styles.css" },
    { "src": "/tokens.css", "dest": "/web/tokens.css" },
    { "src": "/app.js", "dest": "/web/app.js" },
    { "src": "/analytics.js", "dest": "/web/analytics.js" },
    { "src": "/review-intelligence-method.js", "dest": "/web/review-intelligence-method.js" },
    { "src": "/review-intelligence-method.md", "dest": "/web/review-intelligence-method.md" },
    { "src": "/analysis-prompt.js", "dest": "/web/analysis-prompt.js" },
    { "src": "/markets.js", "dest": "/web/markets.js" },
    { "src": "/storefronts.js", "dest": "/web/storefronts.js" },
    { "src": "/review-retriever-og.png", "dest": "/web/review-retriever-og.png" },
    { "src": "/review-retriever-og.svg", "dest": "/web/review-retriever-og.svg" },
    { "src": "/favicon.svg", "dest": "/web/favicon.svg" },
    { "src": "/robots.txt", "dest": "/web/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/web/sitemap.xml" },
    { "src": "/llms.txt", "dest": "/web/llms.txt" },
    { "src": "/app-review-growth-analyzer-skill.zip", "dest": "/web/app-review-growth-analyzer-skill.zip" },
    { "src": "/", "dest": "/web/index.html" }
  ]
}
