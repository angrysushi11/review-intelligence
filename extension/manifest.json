{
  "manifest_version": 3,
  "name": "Review Intel",
  "version": "0.1.1",
  "description": "Open an App Store or Google Play listing in Review Intel with the URL ready to use.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_title": "Open this public app URL in Review Intel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
